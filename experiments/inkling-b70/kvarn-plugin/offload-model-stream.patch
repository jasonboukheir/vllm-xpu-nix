@@ -249,6 +249,57 @@ def _submit(handler, job_id: int) -> bool:
     return handler.transfer_async(job_id, device_ptrs, cpu_spec)
 
 
+@pytest.mark.parametrize("gpu_to_cpu", [False, True])
+def test_xpu_transfer_uses_model_stream(monkeypatch, gpu_to_cpu):
+    platform = MagicMock()
+    platform.is_xpu.return_value = True
+    platform.stream.return_value = contextlib.nullcontext()
+    monkeypatch.setattr(gpu_worker, "current_platform", platform)
+    copy = MagicMock()
+    monkeypatch.setattr(ops, "swap_blocks_batch", copy)
+    handler = gpu_worker.SingleDirectionOffloadingHandler(
+        [torch.zeros((1, 128), dtype=torch.int8)],
+        1,
+        [[CanonicalKVCacheRef(tensor_idx=0, page_size_bytes=128)]],
+        gpu_to_cpu,
+    )
+    handler._buffer_pool = [
+        tuple(torch.zeros(1, dtype=torch.uint64) for _ in range(3)) for _ in range(3)
+    ]
+    handler._event_pool = [MagicMock() for _ in range(6)]
+    first_stream, next_stream = MagicMock(), MagicMock()
+    platform.current_stream.side_effect = [first_stream, first_stream, next_stream]
+    for job_id in range(3):
+        assert _submit(handler, job_id)
+
+    assert [t.stream for t in handler._transfers] == [
+        first_stream,
+        first_stream,
+        next_stream,
+    ]
+    platform.Stream.assert_not_called()
+    first_stream.wait_stream.assert_not_called()
+    first_stream.wait_event.assert_not_called()
+    next_stream.wait_event.assert_called_once_with(handler._transfer_events[1])
+    assert copy.call_count == 3
+    # A borrowed stream must never be returned to the pool. Event completion
+    # still protects the descriptors and drives transfer-byte accounting.
+    handler._transfer_events[0].query.return_value = False
+    assert not handler.get_finished()
+    assert len(handler._transfers) == 3
+    handler._transfer_events[0].query.return_value = True
+    for transfer in handler._transfers:
+        transfer.start_event.elapsed_time.return_value = 1.0
+        transfer.end_event.record.assert_called_once_with(transfer.stream)
+    finished = handler.get_finished()
+    assert [(t.job_id, t.transfer_size) for t in finished] == [
+        (j, 128) for j in range(3)
+    ]
+    assert len(handler._buffer_pool) == 3
+    assert handler._stream_pool is None
+    handler.shutdown()
+
+
