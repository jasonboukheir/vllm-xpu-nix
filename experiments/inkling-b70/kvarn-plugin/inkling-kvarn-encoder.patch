@@ -0,0 +1,158 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Compare physical Inkling K4V4 records with the released fork's CPU codec."""
+
+import os
+from pathlib import Path
+
+from unittest import SkipTest
+import torch
+from vllm.model_executor.layers import quantization
+from vllm.v1.attention import ops
+from vllm_inkling2_xpu.ops.kvarn_encode import encode_complete_pages
+
+
+def expected_record(staging):
+    from vllm.model_executor.layers.quantization.kvarn.sinkhorn import (
+        variance_normalize_batched,
+    )
+    from vllm.v1.attention.ops.kvarn_store import (
+        kvarn_store_tile_k_batch_from_sinkhorn,
+        kvarn_store_tile_v_batch_from_sinkhorn,
+    )
+
+    hadamard = torch.ones(1, 1)
+    for _ in range(7):
+        hadamard = torch.kron(hadamard, torch.tensor([[1.0, 1.0], [1.0, -1.0]]))
+    hadamard /= 128**0.5
+    k, v = (x.float() @ hadamard for x in staging.split(128, dim=-1))
+    arrays = []
+    for value, tile in enumerate((k.permute(1, 2, 0), v.permute(1, 0, 2))):
+        balanced, col, row = variance_normalize_batched(tile.contiguous(), 8)
+        if value:
+            fields = kvarn_store_tile_v_batch_from_sinkhorn(
+                balanced, col.squeeze(1), row.squeeze(2), 4
+            )
+            names = ("q_packed_uint8", "s_col_V", "s_row_V", "zp_V")
+        else:
+            fields = kvarn_store_tile_k_batch_from_sinkhorn(
+                balanced, col.squeeze(1), row.squeeze(2), 4
+            )
+            names = ("q_packed_uint8", "s_col_K", "zp_K", "s_row_K")
+        arrays.extend(
+            fields[name].contiguous().view(torch.uint8).reshape(8, -1) for name in names
+        )
+    return torch.cat(arrays, dim=1)
+
+
+def assert_compatible(got, expected):
+    assert got.shape == expected.shape == (8, 17920)
+    for start in (0, 8960):
+        actual = got[:, start : start + 8192]
+        reference = expected[:, start : start + 8192]
+        for shift in (0, 4):
+            delta = ((actual >> shift) & 15).short() - (
+                (reference >> shift) & 15
+            ).short()
+            # FP32 reduction order may move a quantizer tie into the adjacent bin.
+            assert delta.abs().max() <= 1
+            assert (delta != 0).float().mean() < 0.0005
+
+        def decode(record, bins):
+            scales = (
+                record[:, start + 8192 : start + 8960]
+                .contiguous()
+                .view(torch.float16)
+                .float()
+            )
+            a, b, c = scales.split(128, dim=-1)
+            rs, zp, cs = (b, c, a) if start else (a, b, c)
+            packed = bins[:, start : start + 8192]
+            q = torch.stack((packed & 15, packed >> 4), dim=-1).reshape(8, 128, 128)
+            return (q * rs[:, :, None] + zp[:, :, None]) * cs[:, None, :], scales
+
+        actual_values, actual_scales = decode(got, got)
+        ref_values, ref_scales = decode(expected, got)
+        # Adjacent best Sinkhorn iterations can redistribute a small common
+        # scale between the row and column factors. Check their product in
+        # addition to the individual half-precision fields, with identical
+        # codes to isolate this from the separately bounded rounding ties.
+        torch.testing.assert_close(actual_scales, ref_scales, rtol=0.003, atol=0.00002)
+        errors = (actual_values - ref_values).flatten(1).norm(dim=1)
+        assert (
+            errors / ref_values.flatten(1).norm(dim=1).clamp_min(1e-8)
+        ).max() < 0.003
+
+
+def reference_device():
+    fork = os.environ.get("KVARN_FORK_SOURCE")
+    if not fork:
+        raise SkipTest(
+            "Set KVARN_FORK_SOURCE to the released KVarN fork for record parity"
+        )
+    for package in (quantization, ops):
+        package.__path__.insert(
+            0, str(Path(fork).joinpath(*package.__name__.split(".")))
+        )
+    interpreter = os.environ.get("TRITON_INTERPRET") == "1"
+    device = "cpu" if interpreter else "xpu"
+    if not interpreter and not torch.xpu.is_available():
+        raise SkipTest("Requires an XPU or TRITON_INTERPRET=1")
+    return device
+
+
+def test_completed_inkling_pages():
+    device = reference_device()
+    rng = torch.Generator().manual_seed(1247)
+    stages = torch.randn(3, 128, 8, 256, generator=rng).to(torch.bfloat16)
+    stages[1, :, 0] = 0
+    # Non-unit metadata and page strides exercise padding and physical indirection.
+    slots = torch.tensor([[0, 0, 3, 0, 1, 0, 0, 0]], dtype=torch.int32, device=device)[
+        :, ::2
+    ]
+    dst = torch.full((5, 8, 1, 17952), 173, dtype=torch.uint8, device=device)
+    req_slots = torch.tensor([0], dtype=torch.int32, device=device)
+    kv = stages.to(device).unsqueeze(0)
+    seq = torch.tensor([128 * 3 + 2], dtype=torch.int32, device=device)
+    qstart = torch.tensor([0, 128 * 2 + 7], dtype=torch.int32, device=device)
+    encode_complete_pages(kv, dst[..., :17920], slots, seq, qstart, 263, req_slots)
+    actual = dst.cpu()
+    assert_compatible(actual[3, :, 0, :17920], expected_record(stages[1]))
+    assert_compatible(actual[1, :, 0, :17920], expected_record(stages[2]))
+    assert (actual[[0, 2, 4]] == 173).all()
+    assert (actual[..., 17920:] == 173).all()
+    seq.fill_(382)
+    qstart[1] = 4
+    encode_complete_pages(kv, dst[..., :17920], slots, seq, qstart, 8, req_slots)
+    assert torch.equal(dst.cpu(), actual)
+
+
+def test_shuffled_request_slots():
+    device = reference_device()
+    rng = torch.Generator().manual_seed(1849)
+    stages = torch.randn(4, 2, 128, 8, 256, generator=rng).to(torch.bfloat16)
+    packed = torch.full((9, 8, 1, 17920), 101, device=device, dtype=torch.uint8)
+    # GPU row order changes across steps. The first two active rows finish a
+    # page on distinct stable slots, row 2 only extends an incomplete page.
+    # A padded row carries a poison entry to catch accidental writes.
+    table = torch.tensor(
+        [[0, 4, 0, 0], [0, 0, 0, 7], [0, 0, 0, 1], [2, 2, 2, 2]],
+        device=device,
+        dtype=torch.int32,
+    )
+    slots = torch.tensor([3, 1, 0, -1], device=device, dtype=torch.int32)
+    seq = torch.tensor([260, 513, 470, 128], device=device, dtype=torch.int32)
+    cuq = torch.tensor([0, 8, 16, 24, 32], device=device, dtype=torch.int32)
+    encode_complete_pages(stages.to(device), packed, table, seq, cuq, 8, slots)
+    actual = packed.cpu()
+    assert_compatible(actual[4, :, 0], expected_record(stages[3, 1]))
+    assert_compatible(actual[7, :, 0], expected_record(stages[1, 1]))
+    assert (actual[[0, 1, 2, 3, 5, 6, 8]] == 101).all()
+    # Last-logit replay at an already sealed cached page must preserve every
+    # stored byte even when its staging ring has just been reconstructed.
+    packed.fill_(123)
+    preserve = torch.tensor([1, -1, -1, -1], dtype=torch.int32, device=device)
+    encode_complete_pages(
+        stages.to(device), packed, table, seq, cuq, 8, slots, preserve
+    )
+    assert (packed[4] == 123).all()
+    assert_compatible(packed[7, :, 0].cpu(), expected_record(stages[1, 1]))
