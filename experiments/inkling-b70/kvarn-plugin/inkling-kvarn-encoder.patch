+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Encode completed D128/G128 target pages in the released compact K4V4 format."""
+
+import torch
+
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _rotate_heads(values):
+    # Sylvester FWHT on each token's 128 components, before tiling K or V.
+    cols = tl.arange(0, 128)
+    for shift in tl.static_range(7):
+        bit = 1 << shift
+        index = tl.broadcast_to((cols ^ bit)[None, :], (128, 128))
+        peer = tl.gather(values, index, 1)
+        values = tl.where((cols[None, :] & bit) == 0, values + peer, peer - values)
+    return values * 0.08838834764831845  # 1 / sqrt(128)
+
+
+@triton.jit
+def _std(values, axis: tl.constexpr):
+    # Sample standard deviation with centered FP32 values, including flat rows.
+    mean = tl.sum(values, axis) / 128.0
+    if axis == 0:
+        centered = values - mean[None, :]
+    else:
+        centered = values - mean[:, None]
+    return tl.sqrt(tl.sum(centered * centered, axis) / 127.0)
+
+
+@triton.jit
+def _imbalance(col_std, row_std):
+    return tl.max(col_std, 0) / tl.maximum(tl.min(col_std, 0), 1.0e-8) + tl.max(
+        row_std, 0
+    ) / tl.maximum(tl.min(row_std, 0), 1.0e-8)
+
+
+@triton.jit
+def _balance(tile):
+    # Same log-domain balance and best-iterate criterion as KVarNConfig's
+    # released 8-iteration codec. Keep all reductions in FP32.
+    col_log = tl.full((128,), 0.0, tl.float32)
+    row_log = tl.full((128,), 0.0, tl.float32)
+    best_col = tl.full((128,), 1.0, tl.float32)
+    best_row = tl.full((128,), 1.0, tl.float32)
+    col_std = _std(tile, 0)
+    best = _imbalance(col_std, _std(tile, 1))
+    for _ in range(8):
+        col_log = tl.clamp(col_log + tl.log(tl.clamp(col_std, 1e-3, 1e3)), -0.3, 10.0)
+        col = tl.exp(col_log)
+        cur = tile / col[None, :] / tl.exp(row_log)[:, None]
+        row_log = tl.clamp(
+            row_log + tl.log(tl.clamp(_std(cur, 1), 1e-3, 1e3)), -0.3, 10.0
+        )
+        row = tl.exp(row_log)
+        cur = tile / col[None, :] / row[:, None]
+        col_std = _std(cur, 0)
+        imbalance = _imbalance(col_std, _std(cur, 1))
+        improved = imbalance <= best
+        best_col = tl.where(improved, col, best_col)
+        best_row = tl.where(improved, row, best_row)
+        best = tl.where(improved, imbalance, best)
+    return tile / best_col[None, :] / best_row[:, None], best_col, best_row
+
+
+@triton.jit
+def _encode_record(
+    Staging,
+    Packed,
+    BlockTable,
+    SeqLens,
+    CuQLens,
+    ReqSlots,
+    PreservePages,
+    HAS_PRESERVED: tl.constexpr,
+    src_slot: tl.constexpr,
+    num_slots: tl.constexpr,
+    table_row: tl.constexpr,
+    ring_pages: tl.constexpr,
+    src_page: tl.constexpr,
+    src_token: tl.constexpr,
+    src_head: tl.constexpr,
+    dst_page: tl.constexpr,
+    dst_head: tl.constexpr,
+    table_stride: tl.constexpr,
+    IS_VALUE: tl.constexpr,
+):
+    req = tl.program_id(2)
+    slot = tl.load(ReqSlots + req)
+    if (slot < 0) | (slot >= num_slots):
+        return
+    seq_len = tl.load(SeqLens + req)
+    qlen = tl.load(CuQLens + req + 1) - tl.load(CuQLens + req)
+    if (qlen <= 0) | (qlen > seq_len):
+        return
+    past = seq_len - qlen
+    page = past // 128 + tl.program_id(0)
+    # Handles padding, speculative rollback and graph replay without host reads.
+    if page >= seq_len // 128:
+        return
+    if HAS_PRESERVED:
+        if page == tl.load(PreservePages + req):
+            return
+    physical = tl.load(BlockTable + req * table_row + page * table_stride)
+    if physical <= 0:
+        return
+    head = tl.program_id(1)
+    i = tl.arange(0, 128)
+    offset = (
+        slot.to(tl.int64) * src_slot
+        + (page % ring_pages).to(tl.int64) * src_page
+        + head * src_head
+    )
+    if IS_VALUE:
+        offset += 128
+    values = tl.load(Staging + offset + i[:, None] * src_token + i[None, :]).to(
+        tl.float32
+    )
+    rotated = _rotate_heads(values)
+    if IS_VALUE:
+        tile = rotated
+    else:
+        tile = tl.trans(rotated)
+    balanced, col, row = _balance(tile)
+    lo = tl.min(balanced, 1)
+    scale = tl.maximum((tl.max(balanced, 1) - lo) / 15.0, 1.0e-10)
+    levels = tl.clamp((balanced - lo[:, None]) / scale[:, None], 0.0, 15.0)
+    lower = tl.floor(levels).to(tl.int32)
+    frac = levels - lower.to(tl.float32)
+    q = (lower + ((frac > 0.5) | ((frac == 0.5) & ((lower & 1) != 0))).to(tl.int32)).to(
+        tl.uint8
+    )
+    even, odd = tl.split(tl.reshape(q, (128, 64, 2)))
+    record = Packed + physical.to(tl.int64) * dst_page + head * dst_head
+    half = record.to(tl.pointer_type(tl.float16))
+    payload = i[:, None] * 64 + tl.arange(0, 64)[None, :]
+    if IS_VALUE:
+        tl.store(record + 8960 + payload, even | (odd << 4))
+        tl.store(half + 17152 // 2 + i, col)
+        tl.store(half + 17408 // 2 + i, row * scale)
+        tl.store(half + 17664 // 2 + i, row * lo)
+    else:
+        tl.store(record + payload, even | (odd << 4))
+        tl.store(half + 8192 // 2 + i, row * scale)
+        tl.store(half + 8448 // 2 + i, row * lo)
+        tl.store(half + 8704 // 2 + i, col)
+
+
+def encode_complete_pages(
+    staging: torch.Tensor,
+    packed: torch.Tensor,
+    block_table: torch.Tensor,
+    seq_lens: torch.Tensor,
+    cu_query_lens: torch.Tensor,
+    max_query_len: int,
+    req_slots: torch.Tensor,
+    preserve_pages: torch.Tensor | None = None,
+):
+    """Pack physical pages completed in this XPU forward, including verification."""
+    if (
+        staging.ndim != 5
+        or staging.shape[2:] != (128, 8, 256)
+        or packed.shape[1:] != (8, 1, 17920)
+    ):
+        raise ValueError(f"Unexpected K4V4 geometry: {staging.shape}, {packed.shape}")
+    if staging.stride(-1) != 1 or packed.stride(-1) != 1:
+        raise ValueError(
+            "KVarN input components and output record bytes must be contiguous"
+        )
+    if staging.dtype != torch.bfloat16 or packed.dtype != torch.uint8:
+        raise ValueError("KVarN requires BF16 staging and byte-packed records")
+    n = seq_lens.numel()
+    if (
+        block_table.ndim != 2
+        or block_table.shape[0] < n
+        or req_slots.shape != (n,)
+        or cu_query_lens.shape != (n + 1,)
+    ):
+        raise ValueError("KVarN batch metadata shapes disagree")
+    if (
+        seq_lens.stride(0) != 1
+        or req_slots.stride(0) != 1
+        or cu_query_lens.stride(0) != 1
+    ):
+        raise ValueError("KVarN per-request metadata must be contiguous")
+    if preserve_pages is not None and (
+        preserve_pages.shape != (n,) or preserve_pages.stride(0) != 1
+    ):
+        raise ValueError(
+            "KVarN preserved-page metadata must be contiguous and per-request"
+        )
+    if max_query_len == 0 or n == 0:
+        return
+    grid = (triton.cdiv(max_query_len, 128), 8, n)
+    for is_value in (False, True):
+        _encode_record[grid](
+            staging,
+            packed,
+            block_table,
+            seq_lens,
+            cu_query_lens,
+            req_slots,
+            req_slots if preserve_pages is None else preserve_pages,
+            preserve_pages is not None,
+            staging.stride(0),
+            staging.shape[0],
+            block_table.stride(0),
+            staging.shape[1],
+            staging.stride(1),
+            staging.stride(2),
+            staging.stride(3),
+            packed.stride(0),
+            packed.stride(1),
+            block_table.stride(1),
+            is_value,
+            num_warps=16,
+        )
