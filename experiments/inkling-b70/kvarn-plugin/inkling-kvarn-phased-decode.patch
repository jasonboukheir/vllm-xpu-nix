+            _PHASED_BLOCK_N not in (32, 64, 128)
+            or _PHASED_WARPS not in (4, 8)
+            or not 0 <= _PHASED_SPLITS <= 256
+        ):
+            raise ValueError("Unsupported Inkling KVarN phased decoder tuning")
+        num_splits = _PHASED_SPLITS or num_splits
     # A single split writes the (gated) output itself.
     fuse_gate = num_splits == 1
     o_part = q.new_empty(
@@ -339,12 +355,15 @@ def _decode_attention(
         window=window,
         num_splits=num_splits,
         mode=MODE_GATED if fuse_gate else MODE_PARTIAL,
-        block_n=64 if packed_cache is not None and max_query_len > 32 else 32,
-        num_warps=8 if window else 4,
+        block_n=_PHASED_BLOCK_N
+        if phased
+        else (64 if packed_cache is not None and max_query_len > 32 else 32),
+        num_warps=_PHASED_WARPS if phased else (8 if window else 4),
         packed_cache=packed_cache,
         hadamard=hadamard,
         req_slots=req_slots,
         ring_pages=ring_pages,
+        phased_kvarn=phased,
     )
     if fuse_gate:
         out[num_actual_tokens:].zero_()
diff --git a/src/vllm_inkling2_xpu/ops/attention_triton.py b/src/vllm_inkling2_xpu/ops/attention_triton.py
index f66a847..4fb26da 100644
--- a/src/vllm_inkling2_xpu/ops/attention_triton.py
+++ b/src/vllm_inkling2_xpu/ops/attention_triton.py
@@ -205,6 +205,118 @@ def kvarn_rehydrate(
     return preserve
 
 
+@triton.jit
+def _kvarn_scan_phases(
+    q,
+    K,
+    V,
+    Packed,
+    Hadamard,
+    table,
+    owner,
+    kv_head,
+    rel_row,
+    row_valid,
+    pos,
+    pos_lo,
+    seqlen,
+    past,
+    n_lo,
+    num_iters,
+    split,
+    num_splits,
+    scale,
+    stride_kv_blk,
+    stride_kv_slot,
+    stride_kv_h,
+    stride_pack_page,
+    stride_pack_head,
+    M: tl.constexpr,
+    N: tl.constexpr,
+    D: tl.constexpr,
+    E: tl.constexpr,
+    RING: tl.constexpr,
+):
+    """Process a split's sealed pages, unrotate its output, then extend it."""
+    d = tl.arange(0, D)
+    tile = tl.arange(0, N)
+    start_n = n_lo + split
+    sealed_n = past // 128 * (128 // N)
+    packed_iters = tl.minimum(
+        num_iters, tl.maximum(sealed_n - start_n + num_splits - 1, 0) // num_splits
+    )
+    acc = tl.zeros((M, D), tl.float32)
+    m_i = tl.full((M,), float("-inf"), tl.float32)
+    l_i = tl.zeros((M,), tl.float32)
+    for phase in tl.static_range(2):
+        if phase == 0:
+            begin = 0
+            end = packed_iters
+            query = q
+            if packed_iters > 0:
+                h = tl.load(Hadamard + d[:, None] * D + d[None, :])
+                query = tl.dot(q, h).to(q.dtype)
+        else:
+            begin = packed_iters
+            end = num_iters
+            query = q
+        for i in range(begin, end):
+            n = start_n + i * num_splits
+            tokens = n * N + tile
+            page = (n * N) // 128
+            if phase == 0:
+                physical = tl.load(table + page)
+                record = (
+                    Packed
+                    + physical.to(tl.int64) * stride_pack_page
+                    + kv_head * stride_pack_head
+                )
+                k = _kvarn_key(record, tokens % 128, d).to(q.dtype)
+            else:
+                offset = (owner * RING + page % RING).to(
+                    tl.int64
+                ) * stride_kv_blk + kv_head * stride_kv_h
+                offset += (tokens % 128) * stride_kv_slot
+                k = tl.load(
+                    K + offset[None, :] + d[:, None],
+                    mask=tokens[None, :] < seqlen,
+                    other=0.0,
+                ).to(q.dtype)
+            scores = tl.dot(query, k) * scale
+            # Every sealed key precedes every query. Only the last E keys
+            # before the earliest query can carry learned relative bias.
+            if phase == 1 or n * N + N > pos_lo - E + 1:
+                dist = pos[:, None] - tokens[None, :]
+                valid = (dist >= 0) & (tokens[None, :] < seqlen)
+                bias = tl.load(
+                    rel_row[:, None] + tokens[None, :],
+                    mask=valid & (dist < E) & row_valid[:, None],
+                    other=0.0,
+                )
+                scores += bias.to(tl.float32) * 1.4426950408889634
+                if phase == 1:
+                    scores = tl.where(valid, scores, float("-inf"))
+            m_new = tl.maximum(m_i, tl.max(scores, 1))
+            safe = tl.where(m_new == float("-inf"), 0.0, m_new)
+            a = tl.exp2(m_i - safe)
+            p = tl.exp2(scores - safe[:, None])
+            l_i = l_i * a + tl.sum(p, 1)
+            if phase == 0:
+                value = _kvarn_value(record, tokens % 128, d).to(q.dtype)
+            else:
+                value = tl.load(
+                    V + offset[:, None] + d[None, :],
+                    mask=tokens[:, None] < seqlen,
+                    other=0.0,
+                ).to(q.dtype)
+            acc = acc * a[:, None] + tl.dot(p.to(value.dtype), value)
+            m_i = m_new
+        if phase == 0 and packed_iters > 0:
+            h = tl.load(Hadamard + d[:, None] * D + d[None, :])
+            acc = tl.dot(acc.to(q.dtype), h)
+    return acc, m_i, l_i
+
