     return 1.0 / (1.0 + tl.exp2(-x * 1.4426950408889634))
 
 
+@triton.jit
+def _kvarn_staging_slots(
+    Out,
+    Physical,
+    Seq,
+    CuQ,
+    Owners,
+    Table,
+    Cookies,
+    Tags,
+    N,
+    stride_table,
+    stride_table_page,
+    RING: tl.constexpr,
+):
+    req = tl.program_id(1)
+    start = tl.load(CuQ + req)
+    qlen = tl.load(CuQ + req + 1) - start
+    begin = tl.load(Seq + req) - qlen
+    slot = tl.load(Owners + req)
+    row = tl.program_id(0) * 32 + tl.arange(0, 32)
+    mask = (row < qlen) & (start + row < N)
+    physical = tl.load(Physical + start + row, mask=mask, other=-1)
+    idx = slot * RING + ((begin + row) % RING)
+    tl.store(
+        Out + start + row, tl.where((slot >= 0) & (physical >= 0), idx, -1), mask=mask
+    )
+    # One program stamps each touched logical page; pages form a shorter
+    # interval than the input-token grid. The first program also covers a
+    # boundary crossing by a query of less than 32 tokens.
+    for half in tl.static_range(2):
+        page = begin // 128 + tl.program_id(0) * 2 + half
+        if slot >= 0 and qlen > 0 and page * 128 < begin + qlen:
+            token = start + tl.maximum(page * 128 - begin, 0)
+            if tl.load(Physical + token) >= 0:
+                physical_page = tl.load(
+                    Table + req * stride_table + page * stride_table_page
+                )
+                tag = Tags + (slot * (RING // 128) + page % (RING // 128)) * 3
+                tl.store(tag, tl.load(Cookies + req))
+                tl.store(tag + 1, page)
+                tl.store(tag + 2, physical_page)
+
+
+def kvarn_staging_slots(
+    physical, seq, cuq, owners, max_query_len, ring_pages, block_table, cookies, tags
+):
+    result = torch.full_like(physical, -1)
+    _kvarn_staging_slots[(triton.cdiv(max_query_len, 32), seq.shape[0])](
+        result,
+        physical,
+        seq,
+        cuq,
+        owners,
+        block_table,
+        cookies,
+        tags,
+        physical.numel(),
+        block_table.stride(0),
+        block_table.stride(1),
+        RING=ring_pages * 128,
+    )
+    return result
+
+
+@triton.jit
+def _kvarn_key(record, token, d):
+    # K rows are channels and pairs of token nibbles are adjacent.
+    b = tl.load(record + d[:, None] * 64 + token[None, :] // 2)
+    q = ((b >> ((token[None, :] & 1) * 4)) & 15).to(tl.float32)
+    scales = record.to(tl.pointer_type(tl.float16))
+    s_col = tl.load(scales + 8192 // 2 + d).to(tl.float32)
+    zero = tl.load(scales + 8448 // 2 + d).to(tl.float32)
+    s_row = tl.load(scales + 8704 // 2 + token).to(tl.float32)
+    return (q * s_col[:, None] + zero[:, None]) * s_row[None, :]
+
+
+@triton.jit
+def _kvarn_value(record, token, d):
+    # V rows are tokens and pairs of channel nibbles are adjacent.
+    b = tl.load(record + 8960 + token[:, None] * 64 + d[None, :] // 2)
+    q = ((b >> ((d[None, :] & 1) * 4)) & 15).to(tl.float32)
+    scales = record.to(tl.pointer_type(tl.float16))
+    s_col = tl.load(scales + 17152 // 2 + d).to(tl.float32)
+    s_row = tl.load(scales + 17408 // 2 + token).to(tl.float32)
+    zero = tl.load(scales + 17664 // 2 + token).to(tl.float32)
+    return (q * s_row[:, None] + zero[:, None]) * s_col[None, :]
+
+
+@triton.jit
+def _rehydrate_partial(
+    Staging,
+    Packed,
+    Table,
+    Seq,
+    CuQ,
+    Owners,
+    Cookies,
+    Tags,
+    H,
+    IsPrefill,
+    Preserve,
+    stride_page,
+    stride_head,
+    stride_table,
+    stride_table_page,
+    RING: tl.constexpr,
+    N: tl.constexpr,
+):
+    req = tl.program_id(0)
+    owner = tl.load(Owners + req)
+    qlen = tl.load(CuQ + req + 1) - tl.load(CuQ + req)
+    past = tl.load(Seq + req) - qlen
+    if owner < 0 or qlen <= 0 or past % 128 == 0:
+        return
+    page = past // 128
+    physical = tl.load(Table + req * stride_table + page * stride_table_page)
+    if physical <= 0:
+        return
+    ring = owner * RING + page % RING
+    tag = Tags + ring * 3
+    if (
+        tl.load(tag) == tl.load(Cookies + req)
+        and tl.load(tag + 1) == page
+        and tl.load(tag + 2) == physical
+    ):
+        return
+    # A cold or evicted partial prefix comes from a sealed planner-owned page.
+    # GPU/host APC can return one less token to recompute the final logits.
+    head = tl.program_id(1)
+    # Native whole-page prefix hits can replay the final matched token to
+    # produce logits. Keep those canonical sealed bytes across repeated hits.
+    if head == 0 and tl.program_id(2) == 0 and past % 128 == 127 and qlen == 1:
+        if tl.load(IsPrefill + req):
+            tl.store(Preserve + req, page)
+    token = tl.program_id(2) * N + tl.arange(0, N)
+    d = tl.arange(0, 128)
+    record = Packed + physical.to(tl.int64) * stride_page + head * stride_head
+    h = tl.load(H + d[:, None] * 128 + d[None, :])
+    k = tl.dot(tl.trans(_kvarn_key(record, token, d)).to(h.dtype), h)
+    v = tl.dot(_kvarn_value(record, token, d).to(h.dtype), h)
+    dst = (
+        Staging
+        + (((ring.to(tl.int64) * 128 + token[:, None]) * 8 + head) * 256)
+        + d[None, :]
+    )
+    mask = token[:, None] < past % 128
+    tl.store(dst, k, mask=mask)
+    tl.store(dst + 128, v, mask=mask)
+
+
+def kvarn_rehydrate(
+    staging, packed, table, seq, cuq, owners, cookies, tags, hadamard, is_prefilling
+):
+    assert staging.is_contiguous() and tags.is_contiguous()
+    preserve = torch.full_like(seq, -1)
+    _rehydrate_partial[(seq.shape[0], 8, 4)](
+        staging,
+        packed,
+        table,
+        seq,
+        cuq,
+        owners,
+        cookies,
+        tags,
+        hadamard,
+        is_prefilling,
+        preserve,
+        packed.stride(0),
+        packed.stride(1),
+        table.stride(0),
+        table.stride(1),
+        RING=staging.shape[1],
+        N=32,
+    )
+    return preserve
+
+
 @triton.jit
