+function(add_split_kernel name directory)
+  string(TOUPPER "${name}" upper_name)
+  set(prebuilt "VLLM_XPU_PREBUILT_${upper_name}_LIB")
+  if(DEFINED ENV{${prebuilt}})
+    add_library(${name} SHARED IMPORTED GLOBAL)
+    get_filename_component(parent "${directory}" DIRECTORY)
+    set_target_properties(${name} PROPERTIES
+      IMPORTED_LOCATION "$ENV{${prebuilt}}"
+      INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/${directory};${CMAKE_SOURCE_DIR}/${parent};${CMAKE_SOURCE_DIR}")
+  else()
+    add_subdirectory(${directory})
+  endif()
+endfunction()
