From: vllm-xpu-nix <noreply@anthropic.com>
Subject: [PATCH] cmake: configure device-link concurrency and diagnostic depth

Expose two existing compiler options as CMake cache variables. Defaults match
upstream's hardcoded values.

  * VLLM_XPU_SYCL_LINK_PARALLELISM (default 16) controls parallel device-link
    jobs. Downstream split libraries set it from NIX_BUILD_CORES so operators
    can bound this concurrency with --cores.
  * VLLM_XPU_CUTLASS_TEMPLATE_BACKTRACE_LIMIT (default 0, unlimited) limits
    template diagnostic entries. Downstream selects 10. A successful-build
    memory or compile-time benefit has not been measured.

The existing -flink-huge-device-code option is unchanged.
---
 CMakeLists.txt | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -265,6 +265,8 @@
   set(VLLM_GPU_COMPILE_FLAGS ${SYCL_COMPILE_FLAGS})
 
   # ============= LINK OPTIONS ==================
+  set(VLLM_XPU_SYCL_LINK_PARALLELISM "16" CACHE STRING
+      "Maximum parallel SYCL device-link jobs (-fsycl-max-parallel-link-jobs).")
   set(SYCL_LINK_FLAGS "")
   list(APPEND SYCL_LINK_FLAGS "-fsycl")
   # For l0 ops like getMemoryInfo
@@ -272,7 +274,8 @@
   list(APPEND SYCL_LINK_FLAGS "-Wno-unused-command-line-argument")
   set(SYCL_DEVICE_LINK_FLAGS ${SYCL_LINK_FLAGS})
   set(SYCL_DEVICE_LINK_FLAGS
-      ${SYCL_DEVICE_LINK_FLAGS} -fsycl-max-parallel-link-jobs=16
+      ${SYCL_DEVICE_LINK_FLAGS}
+      -fsycl-max-parallel-link-jobs=${VLLM_XPU_SYCL_LINK_PARALLELISM}
       -flink-huge-device-code)
   set(SYCL_DEVICE_LINK_FLAGS
       ${SYCL_DEVICE_LINK_FLAGS}
@@ -375,7 +378,9 @@
   list(APPEND VLLM_CUTLASS_FLAGS "-DCUTLASS_ENABLE_SYCL")
   list(APPEND VLLM_CUTLASS_FLAGS "-DSYCL_INTEL_TARGET")
   list(APPEND VLLM_CUTLASS_FLAGS "-DCUTLASS_VERSIONS_GENERATED")
-  list(APPEND VLLM_CUTLASS_FLAGS "-ftemplate-backtrace-limit=0")
+  set(VLLM_XPU_CUTLASS_TEMPLATE_BACKTRACE_LIMIT "0" CACHE STRING
+      "Template diagnostic backtrace depth for CUTLASS-SYCL TUs; 0 = unlimited.")
+  list(APPEND VLLM_CUTLASS_FLAGS "-ftemplate-backtrace-limit=${VLLM_XPU_CUTLASS_TEMPLATE_BACKTRACE_LIMIT}")
   list(APPEND VLLM_CUTLASS_FLAGS "-fdiagnostics-color=always")
 endif()
 
