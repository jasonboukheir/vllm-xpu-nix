@@ -564,13 +566,13 @@ def vmm_unavailable_reason(export_handle_types: int = 0) -> str | None:
     Checks library load, entry points, known runtime defects (by probing), and
     one reserve/create/map/set-access/unmap/release round trip of a single
     granule, created with `export_handle_types` (see `VmmDriver.create`).
-    Covers WSL2 and non-CUDA/ROCm builds.
+    Covers CUDA, ROCm and XPU builds.
     """
     try:
         import torch
 
         if not torch.accelerator.is_available():
-            return "no CUDA/ROCm device is available"
+            return "no accelerator device is available"
         driver = get_vmm_driver()
         device_index = torch.accelerator.current_device_index()
         driver.ensure_context(device_index)
