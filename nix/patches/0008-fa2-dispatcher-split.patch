+#include "paged_decode_extern.hpp"
+#include "paged_decode_utils.hpp"
+
+using namespace cute;
+
+// clang-format off
+#define IMPL_QGROUP ${IMPL_QGROUP}
+#define IMPL_PAGESIZE ${IMPL_PAGESIZE}
+// clang-format on
+
+#define CONCAT_INNER(a, b) a##b
+#define CONCAT(a, b) CONCAT_INNER(a, b)
+
+#define SHARD_FUNCTION_NAME \
+  CONCAT(paged_decode_dispatch_q, CONCAT(IMPL_QGROUP, CONCAT(_p, IMPL_PAGESIZE)))
+
+#define QGROUP_TYPE CONCAT(_, IMPL_QGROUP)
+#define PAGESIZE_TYPE CONCAT(_, IMPL_PAGESIZE)
+
+// One (QGroup, PageSize) dispatcher shard. The recursive trampoline forest
+// (6 head_case × 8 bool × 6 dtype = 288 leaves) lives entirely inside this
+// TU. paged_decode_xe2.cpp performs the page_size → PageSize and
+// num_q_group_size → QGroup routing and calls into the right shard, so the
+// entry TU does not need to include paged_decode.hpp (and avoids parsing the
+// CUTLASS / SYCL kernel pipeline templates).
+void SHARD_FUNCTION_NAME(
+    int head_case,
+    sycl::queue& queue,
+    CutlassQKType& cuQKType,
+    const paged_decode_args_t& args) {
+  dispatch_by_head_size<QGROUP_TYPE, PAGESIZE_TYPE>(
+      head_case, queue, cuQKType, args);
+}
