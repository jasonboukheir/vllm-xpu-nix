+# SPDX-License-Identifier: Apache-2.0
+"""Direct compact K4V4 reads combined with Inkling's current dense tile."""
+
+import os
+from unittest import SkipTest
+
+import torch
+
+
+def test_kvarn_attention_pages():
+    from vllm_inkling2_xpu.ops.attention import rel_decode_attention
+
+    interpret = os.environ.get("TRITON_INTERPRET") == "1"
+    if not interpret and not torch.xpu.is_available():
+        raise SkipTest("Requires XPU or Triton's interpreter")
+    device = "cpu" if interpret else "xpu"
+    # The interpreter's dot handles fp16 in software. Hardware uses model BF16.
+    dtype = torch.float16 if interpret else torch.bfloat16
+    rng = torch.Generator().manual_seed(189)
+    h = torch.ones(1, 1)
+    for _ in range(7):
+        h = torch.kron(h, torch.tensor([[1.0, 1.0], [1.0, -1.0]]))
+    h /= 128**0.5
+    packed = torch.randint(0, 256, (5, 8, 1, 17952), dtype=torch.uint8, generator=rng)
+    db = packed[..., :17920]
+    # A physical page spans larger strides than its logical record.
+    raw = db[:, :, 0]
+    physical = 3
+    k = torch.randint(0, 16, (8, 128, 128), generator=rng, dtype=torch.uint8)
+    v = torch.randint(0, 16, (8, 128, 128), generator=rng, dtype=torch.uint8)
+    raw[physical, :, :8192] = (k[..., ::2] | k[..., 1::2] << 4).flatten(1)
+    raw[physical, :, 8960:17152] = (v[..., ::2] | v[..., 1::2] << 4).flatten(1)
+    # Distinct nontrivial row, column, and zero terms catch offset swaps.
+    scalars = []
+    for start, midpoint in (
+        (8192, 0.15),
+        (8448, -1.0),
+        (8704, 0.9),
+        (17152, 0.8),
+        (17408, 0.1),
+        (17664, -0.7),
+    ):
+        values = (torch.rand((8, 128), generator=rng) * 0.15 + midpoint).half()
+        raw[physical, :, start : start + 256] = values.view(torch.uint8)
+        scalars.append(values.float())
+    kc, kz, kr, vc, vr, vz = scalars
+    keys = (
+        ((k.float() * kc[:, :, None] + kz[:, :, None]) * kr[:, None, :]).transpose(1, 2)
+        @ h
+    ).transpose(0, 1)
+    values = (
+        ((v.float() * vr[:, :, None] + vz[:, :, None]) * vc[:, None, :]) @ h
+    ).transpose(0, 1)
+    staging = torch.randn((4, 128, 8, 256), generator=rng).to(dtype)
+    for qlen, past, splits in ((1, 131, 1), (8, 132, 3), (35, 129, 1)):
+        # Old logical page 0 is packed in physical page 3, page 1 lives
+        # in staging. The last two query rows are inert graph padding.
+        src = staging[1, : past + qlen - 128].float()
+        kd = torch.cat((keys, src[..., :128])).repeat_interleave(3, dim=1)
+        vd = torch.cat((values, src[..., 128:])).repeat_interleave(3, dim=1)
+        q = torch.randn((qlen + 2, 24, 128), generator=rng).to(dtype)
+        gate = torch.randn((qlen + 2, 24 * 128), generator=rng).to(dtype)
+        sink = (torch.randn((qlen + 2, 24), generator=rng) + 5).to(dtype)
+        logits = torch.randn((qlen, 24, 1024), generator=rng).to(dtype)
+        rel = torch.full((qlen + 2 + 128, 24, 1280), float("nan"), dtype=dtype)
+        pos = torch.arange(qlen) + past
+        key_pos = torch.arange(past + qlen)
+        dist = pos[:, None] - key_pos
+        bias = logits.gather(2, dist[:, None].expand(-1, 24, -1).clamp(0, 1023))
+        base = ((past + qlen + 127) // 128) * 128 - 1280
+        rel[:qlen, :, key_pos - base] = bias
+        scores = torch.einsum("qhd,khd->qhk", q[:qlen].float(), kd) / 128**0.5 + bias
+        scores.masked_fill_(dist[:, None] < 0, -torch.inf)
+        out = torch.einsum("qhk,khd->qhd", scores.softmax(-1), vd)
+        expected = out * gate[:qlen].reshape(qlen, 24, 128).float().sigmoid()
+        expected *= (scores.logsumexp(-1) - sink[:qlen].float()).sigmoid()[..., None]
+        st = staging.to(device)
+        result = torch.full(gate.shape, float("nan"), dtype=dtype, device=device)
+        rel_decode_attention(
+            q.to(device),
+            st[..., :128],
+            st[..., 128:],
+            rel.to(device),
+            gate.to(device),
+            sink.to(device),
+            result,
+            block_table=torch.tensor([[3, 1]], dtype=torch.int32, device=device),
+            cache_seqlens=torch.tensor([past + qlen], dtype=torch.int32, device=device),
+            cu_seqlens_q=torch.tensor([0, qlen], dtype=torch.int32, device=device),
+            max_query_len=qlen,
+            num_actual_tokens=qlen,
+            softmax_scale=128**-0.5,
+            is_local=False,
+            num_splits=splits,
+            packed_cache=packed.to(device)[..., :17920],
+            hadamard=h.to(device, dtype),
+        )
+        got = result.cpu().view(-1, 24, 128).float()
+        torch.testing.assert_close(got[:qlen], expected, rtol=0.02, atol=0.005)
+        assert (got[qlen:] == 0).all()
+
+
+def test_kvarn_rehydrate_and_reordered_slots():
+    from vllm_inkling2_xpu.ops.attention import rel_decode_attention
+    from vllm_inkling2_xpu.ops.attention_triton import (
+        kvarn_rehydrate,
+        kvarn_staging_slots,
+    )
+
+    interpret = os.environ.get("TRITON_INTERPRET") == "1"
+    if not interpret and not torch.xpu.is_available():
+        raise SkipTest("Requires XPU or Triton's interpreter")
+    device = "cpu" if interpret else "xpu"
+    dtype = torch.float16 if interpret else torch.bfloat16
+
+    def i32(t):
+        return torch.tensor(t, device=device, dtype=torch.int32)
+
+    rng = torch.Generator().manual_seed(341)
+    h = torch.ones(1, 1)
+    for _ in range(7):
+        h = torch.kron(h, torch.tensor([[1.0, 1.0], [1.0, -1.0]]))
+    h = (h / 128**0.5).to(device, dtype)
+    packed = torch.zeros(12, 8, 1, 17952, dtype=torch.uint8, device=device)[..., :17920]
+    for block in range(12):
+        rec = packed[block, :, 0]
+        for offset, val in (
+            (8192, 1),
+            (8448, block * 0.1),
+            (8704, 1),
+            (17152, 1),
+            (17408, 1),
+            (17664, block * 0.2),
+        ):
+            rec[:, offset : offset + 256].view(torch.float16).fill_(val)
+    staging = torch.randn((4, 3, 128, 8, 256), generator=rng).to(device, dtype)
+    tags = torch.full((4, 3, 3), -1, device=device, dtype=torch.int64)
+    owners = i32([2, 0, 3, -1])
+    cookies = torch.tensor([101, 102, 103, 0], device=device)
+    past = [1023, 3, 129, 0]
+    lens = [1, 5, 8, 0]
+    seq = i32([p + q for p, q in zip(past, lens)])
+    cuq = i32([0, 1, 6, 14, 14])
+    table = i32([[3, 5, 4, 6, 1, 7, 9, 2], [7] * 8, [5, 3, 8, 1, 7, 2, 9, 6], [0] * 8])
+    tags[0, 0] = torch.tensor([102, 0, 7], device=device)
+    before = staging.clone()
+    prefill = torch.tensor([True, False, True, False], device=device)
+    preserve = kvarn_rehydrate(
+        staging, packed, table, seq, cuq, owners, cookies, tags, h, prefill
+    )
+    assert preserve.cpu().tolist() == [7, -1, -1, -1]
+    # Cold 1023-token prefix reload, and a different request at offset 1.
+    for owner, page, end, physical in ((2, 7, 127, 2), (3, 1, 1, 3)):
+        restored = staging[owner, page % 3]
+        expected = torch.zeros((end, 8, 256), dtype=dtype, device=device)
+        expected[..., 0] = physical * 0.1 * 128**0.5
+        expected[..., 128] = physical * 0.2 * 128**0.5
+        torch.testing.assert_close(restored[:end], expected, rtol=0.012, atol=0.01)
+        torch.testing.assert_close(restored[end:], before[owner, page % 3, end:])
+    assert torch.equal(staging[0], before[0])
+    physical = torch.arange(16, device=device, dtype=torch.int64)
+    physical[4] = -1
+    slots = kvarn_staging_slots(physical, seq, cuq, owners, 8, 3, table, cookies, tags)
+    target = (
+        [2 * 384 + 1023 % 384, 3, 4, 5, -1, 7]
+        + [3 * 384 + 129 + i for i in range(8)]
+        + [-1, -1]
+    )
+    assert slots.cpu().tolist() == target
+    assert tags[2, 1].cpu().tolist() == [101, 7, 2]
+    assert tags[3, 1].cpu().tolist() == [103, 1, 3]
+    q = torch.randn((16, 24, 128), generator=rng).to(device, dtype)
+    gate = torch.randn((16, 24 * 128), generator=rng).to(device, dtype)
+    sink = torch.randn((16, 24), generator=rng).to(device, dtype)
+    rel = torch.zeros((16 + 128, 24, 1280), dtype=dtype, device=device)
+    result = torch.full_like(gate, float("nan"))
+    common = dict(
+        softmax_scale=128**-0.5,
+        is_local=False,
+        num_splits=2,
+        packed_cache=packed,
+        hadamard=h,
+    )
+    all_k, all_v = staging.flatten(0, 1).split(128, dim=-1)
+    rel_decode_attention(
+        q,
+        all_k,
+        all_v,
+        rel,
+        gate,
+        sink,
+        result,
+        block_table=table,
+        cache_seqlens=seq,
+        cu_seqlens_q=cuq,
+        max_query_len=8,
+        num_actual_tokens=14,
+        req_slots=owners,
+        ring_pages=3,
+        **common,
+    )
+    offset = 0
+    for n, owner in enumerate((2, 0, 3)):
+        count = lens[n]
+        part = slice(offset, offset + count)
+        expected = torch.empty_like(result[part])
+        k, v = staging[owner].split(128, dim=-1)
+        rel_decode_attention(
+            q[part],
+            k,
+            v,
+            rel,
+            gate[part],
+            sink[part],
+            expected,
+            block_table=table[n : n + 1],
+            cache_seqlens=seq[n : n + 1],
+            cu_seqlens_q=i32([0, count]),
+            max_query_len=8,
+            num_actual_tokens=count,
+            **common,
+        )
+        torch.testing.assert_close(result[part], expected, rtol=0, atol=0)
+        offset += count
+    assert (result[14:] == 0).all()
