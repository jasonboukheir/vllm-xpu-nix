@@ -221,6 +221,16 @@ def uint8_tensor_from_ptr(ptr: int, num_bytes: int, device_index: int) -> torch.
     view is destroyed, which can be after this module's globals are cleared at
     interpreter exit. Its deleter is NULL, so nothing calls back into Python.
     """
+    device_type = get_vmm_driver().dlpack_device_type
+    if device_type == 14:  # kDLOneAPI
+        # DLPack asks the XPU driver which device owns the pointer. A new
+        # virtual reservation has no physical pages for that query yet.
+        device = torch.device("xpu", device_index)
+        storage = torch._C._construct_storage_from_data_pointer(ptr, device, num_bytes)
+        return torch.empty(0, dtype=torch.uint8, device=device).set_(
+            storage, 0, (num_bytes,), (1,)
+        )
+
     managed_size = ctypes.sizeof(_DLManagedTensor)
     addr = _malloc(managed_size + ctypes.sizeof(ctypes.c_int64))
     if not addr:
@@ -231,7 +241,6 @@ def uint8_tensor_from_ptr(ptr: int, num_bytes: int, device_index: int) -> torch.
 
     managed = _DLManagedTensor.from_address(addr)
     managed.dl_tensor.data = ctypes.c_void_p(ptr)
-    device_type = get_vmm_driver().dlpack_device_type
     managed.dl_tensor.device = _DLDevice(device_type, device_index)
     managed.dl_tensor.ndim = 1
     managed.dl_tensor.dtype = _DLDataType(_K_DL_UINT, _UINT8_BITS, 1)
@@ -281,8 +290,16 @@ class ExtensibleTensor:
         if device is None:
             device = torch.accelerator.current_device_index()
         dev = device if isinstance(device, torch.device) else torch.device(device)
-        if dev.type != "cuda":
-            raise ValueError(f"ExtensibleTensor requires a cuda device, got {dev}.")
+        accelerator = torch.accelerator.current_accelerator()
+        if (
+            accelerator is None
+            or dev.type not in ("cuda", "xpu")
+            or dev.type != accelerator.type
