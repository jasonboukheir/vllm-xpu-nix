From: vllm-xpu-nix <noreply@anthropic.com>
Subject: [PATCH] fa2 xe2: split dispatcher TU into per-policy shards

Both fmha_xe2.cpp and paged_decode_xe2.cpp are entry TUs that ATen-to-args
plumb into the FA2 chunk_prefill / paged_decode runtime dispatcher. Before
this patch they each included chunk_prefill.hpp / paged_decode.hpp (full
CUTLASS + SYCL kernel pipeline parse, ~3 GiB icpx RSS just to elaborate the
PagedDecodeConfig / FMHAConfig machinery) AND instantiated the entire
runtime trampoline forest: dispatch_by_page_size -> dispatch_by_head_size
-> decode_policy_dispatch_func recursive bool peel -> leaf with a 6-way Q/KV
dtype switch. For paged_decode that is 2 QGroup x 3 PageSize x 7 head_case
x 8 bool x 6 dtype = ~2k trampolines; for chunk_prefill it is 12 policy x
~18 bool combos x 6 dtype = ~1.3k trampolines.

0007-fa2-dtype-split.patch fixed the kernel_template TUs but the dispatcher
TUs were left whole. On a 24-core / 96-GiB box at `-j$(nproc)` the
dispatcher TU peak combined with concurrent kernel_template TUs (each ~7
GiB peak) exhausted RAM and the kernel OOM-killed icpx mid-compile of
paged_decode_xe2.cpp.

This patch splits each dispatcher into per-policy shards:

  * paged_decode: 6 shards by (QGroup, PageSize). Each shard contains exactly
    one `dispatch_by_head_size<QGroup, PageSize>` instantiation (7 head x
    8 bool x 6 dtype = ~336 trampolines per TU). page_size=128 still routes
    through PageSize=_64 at runtime (the existing ReduceK=8 SLM-reduction
    bug in the _128 policy is preserved as a comment).

  * chunk_prefill: 12 shards by chunk_policy. Each shard contains exactly
    one `policy_dispatch_func<chunk_policy_head*>` instantiation (~18 bool
    combos x 6 dtype = ~108 trampolines per TU).

The args structs (paged_decode_args_t, chunk_prefill_args_t) are factored
into thin args.hpp headers so the entry TUs (paged_decode_xe2.cpp,
fmha_xe2.cpp) can construct them without transitively including
paged_decode.hpp / chunk_prefill.hpp. The entry TUs now only include
fmha_utils.hpp + the new args.hpp + the new dispatcher.hpp surface; the
CUTLASS / SYCL kernel pipeline headers stay out of the entry TUs entirely.

The dispatch_by_head_size case 6 (head_size=576) is gated behind
`if constexpr (PageSize::value >= 64)` so the (p16, p32) shards never
implicitly instantiate decode_policy_dispatch_impl<*, h576_p{16,32}, ...>
— PAGED_DECODE_POLICY_LIST omits h576_p{16,32} but the underlying
decode_policy_qpacked_head<*, _576, _{16,32}> partial-specialisation is
valid, so without the gate the missing extern templates force implicit
instantiation of the full SYCL kernel pipeline per shard (~18 GiB RSS,
OOM at -j$(nproc)).

Effect: dispatcher per-TU peak RSS drops below the kernel_template TU
ceiling, so a `-j$(nproc)` build on a 24-core / 96-GiB box no longer
needs the historical `--cores N` cap.

For non-Nix consumers the change is byte-equivalent at the .so level; only
the TU graph for the attn lib widens (six paged_decode_dispatcher_shard +
twelve chunk_prefill_dispatcher_shard generated .cpps).


diff --git a/csrc/xpu/attn/xe_2/chunk_prefill_args.hpp b/csrc/xpu/attn/xe_2/chunk_prefill_args.hpp
--- a/csrc/xpu/attn/xe_2/chunk_prefill_args.hpp
+++ b/csrc/xpu/attn/xe_2/chunk_prefill_args.hpp
@@ -0,0 +1,61 @@
+#pragma once
+
+// POD args struct for the chunk-prefill kernel API. Carved out of
+// chunk_prefill.hpp so the dispatcher entry TU (fmha_xe2.cpp) and the thin
+// dispatcher header (chunk_prefill_dispatcher.hpp) can use it without
+// transitively pulling in CUTLASS / SYCL kernel pipeline headers.
+//
+// Keep this header free of template/CUTLASS includes — that is the entire
+// point of the split.
+struct chunk_prefill_args_t {
+  void* query;
+  void* key;
+  void* value;
+  void* out;
+  void* block_table;
+  void* cu_seqlens_q;
+  void* cu_seqlens_k;
+  int max_queries;
+  int max_keys;
+  int total_seqlen_q;
+  int total_seqlen_k;
+  void* k_scale;
+  void* v_scale;
+  float sm_scale;
+  void* sm_sink;
+  int batch_size;
+  int num_heads_q;
+  int num_heads_k;
+  int head_size;
+  int max_blocks_per_seq;
+  int block_size;
+  int window_size_left = -1;
+  int window_size_right = -1;
+  bool is_varlen = false;
+  bool is_paged = false;
+  bool is_causal = false;
+  bool is_local = false;
+  bool is_sink = false;
+  // softmax_lse output (nullptr when not requested)
+  float* softmax_lse = nullptr;
+  int lse_stride = 0;  // stride along seq dim (= num_heads_q)
+  // Q/O strides in CUTLASS order: (seq, head_size=1, heads, batch)
+  int q_stride_seq = 0;
+  int q_stride_heads = 0;
+  int q_stride_batch = 0;
+  // K strides in CUTLASS order: (seq, head_size=1, heads, batch)
+  int k_stride_seq = 0;
+  int k_stride_heads = 0;
+  int k_stride_batch = 0;
+  // V strides in CUTLASS order: (head_size=1, seq, heads, batch)
+  int v_stride_seq = 0;
+  int v_stride_heads = 0;
+  int v_stride_batch = 0;
+  // O strides in CUTLASS order: (seq, head_size=1, heads, batch)
+  int o_stride_seq = 0;
+  int o_stride_heads = 0;
+  int o_stride_batch = 0;
+  // per-batch mask: true = prefill, false = decode; nullptr = process all
+  void* is_prefill = nullptr;
+  int page_stride_elements = 0;
+};
diff --git a/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher_configure.cmake b/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher_configure.cmake
--- a/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher_configure.cmake
+++ b/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher_configure.cmake
@@ -0,0 +1,64 @@
+# =============================================================================
+# Chunk-prefill Dispatcher Shard Configuration
+# =============================================================================
+# Emits one .cpp per chunk_policy that wraps policy_dispatch_func<policy> in
+# a free function declared in chunk_prefill_dispatcher.hpp. Splitting the
+# dispatcher across 12 policy shards drops the per-TU trampoline forest from
+# ~1300 (12 policies × ~18 bool combos × 6 dtype) to ~108 (~18 bool × 6
+# dtype) and keeps the CUTLASS header parse out of the entry TU fmha_xe2.cpp.
+#
+# Output: appended to ATTN_KERNEL_SRCS_GEN so the shards get linked into
+# attn_kernels_xe_2 by add_xe2_kernel_library.
+# =============================================================================
+
+function(chunk_prefill_dispatcher_configure FILENAME_SUFFIX)
+  set(GEN_KERNEL_SRCS)
+
+  # (filename token, fully-qualified policy type). Keep in sync with
+  # CHUNK_POLICY_LIST in chunk_prefill_extern.hpp and the policy structs in
+  # fmha_utils.hpp.
+  set(policy_pairs
+      "head64|chunk_policy_head64"
+      "head96|chunk_policy_head96"
+      "head128|chunk_policy_head128"
+      "head192|chunk_policy_head192"
+      "head256|chunk_policy_head256"
+      "head512|chunk_policy_head512"
+      "head64_b16|chunk_policy_head64_b16"
+      "head96_b16|chunk_policy_head96_b16"
+      "head128_b16|chunk_policy_head128_b16"
+      "head192_b16|chunk_policy_head192_b16"
+      "head256_b16|chunk_policy_head256_b16"
+      "head512_b16|chunk_policy_head512_b16")
+
+  foreach(_pair ${policy_pairs})
+    string(REPLACE "|" ";" _pair_list "${_pair}")
+    list(GET _pair_list 0 IMPL_POLICY_TOKEN)
+    list(GET _pair_list 1 IMPL_POLICY)
+    set(FILE_SUFFIX "_${IMPL_POLICY_TOKEN}")
+    configure_file(${FILENAME_SUFFIX}.cpp.in
+                   "${FILENAME_SUFFIX}${FILE_SUFFIX}.cpp")
+    list(
+      APPEND
+      GEN_KERNEL_SRCS
+      "${CMAKE_CURRENT_BINARY_DIR}/${FILENAME_SUFFIX}${FILE_SUFFIX}.cpp")
+  endforeach()
+
+  list(REMOVE_DUPLICATES GEN_KERNEL_SRCS)
+  list(LENGTH GEN_KERNEL_SRCS GEN_KERNEL_SRCS_LENGTH)
+  message(
+    STATUS
+      "Generated ${FILENAME_SUFFIX} sources: ${GEN_KERNEL_SRCS_LENGTH} shards")
+
+  set(GEN_KERNEL_SRCS
+      ${GEN_KERNEL_SRCS}
+      PARENT_SCOPE)
+  set(GEN_KERNEL_SRCS_LENGTH
+      ${GEN_KERNEL_SRCS_LENGTH}
+      PARENT_SCOPE)
+
+  list(APPEND ATTN_KERNEL_SRCS_GEN ${GEN_KERNEL_SRCS})
+  set(ATTN_KERNEL_SRCS_GEN
+      ${ATTN_KERNEL_SRCS_GEN}
+      PARENT_SCOPE)
+endfunction()
diff --git a/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher.hpp b/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher.hpp
--- a/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher.hpp
+++ b/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher.hpp
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <sycl/sycl.hpp>
+
+#include "chunk_prefill_args.hpp"
+#include "fmha_utils.hpp"
+
+// Thin dispatcher header. fmha_xe2.cpp picks the right chunk_policy shard
+// from runtime head_size + use_b16 and calls one of the entry points below.
+// Each entry point is defined in its own .cpp generated by
+// chunk_prefill_dispatcher_configure.cmake and contains exactly one
+// instantiation of policy_dispatch_func<chunk_policy_*> — its trampoline
+// forest is the recursive 5-bool peel × 6 dtype = ~108 leaves per shard
+// (down from ~1300 in the previous single-TU dispatcher).
+//
+// Each shard expands to a small free function that delegates into
+// policy_dispatch_func<chunk_policy_*>(queue, cuQKType, args, is_paged,
+// is_causal, is_local, is_sink, is_lse); the head-size + use_b16 routing
+// lives in fmha_xe2.cpp.
+//
+// Keep this header free of CUTLASS / SYCL kernel includes.
+
+#define CHUNK_PREFILL_DECLARE_SHARD(POLICY_TOKEN)                    \
+  void chunk_prefill_dispatch_##POLICY_TOKEN(                        \
+      sycl::queue& queue,                                            \
+      CutlassQKType& cuQKType,                                       \
+      const chunk_prefill_args_t& args,                              \
+      bool is_paged,                                                 \
+      bool is_causal,                                                \
+      bool is_local,                                                 \
+      bool is_sink,                                                  \
+      bool is_lse);
+
+CHUNK_PREFILL_DECLARE_SHARD(head64)
+CHUNK_PREFILL_DECLARE_SHARD(head96)
+CHUNK_PREFILL_DECLARE_SHARD(head128)
+CHUNK_PREFILL_DECLARE_SHARD(head192)
+CHUNK_PREFILL_DECLARE_SHARD(head256)
+CHUNK_PREFILL_DECLARE_SHARD(head512)
+CHUNK_PREFILL_DECLARE_SHARD(head64_b16)
+CHUNK_PREFILL_DECLARE_SHARD(head96_b16)
+CHUNK_PREFILL_DECLARE_SHARD(head128_b16)
+CHUNK_PREFILL_DECLARE_SHARD(head192_b16)
+CHUNK_PREFILL_DECLARE_SHARD(head256_b16)
+CHUNK_PREFILL_DECLARE_SHARD(head512_b16)
+
+#undef CHUNK_PREFILL_DECLARE_SHARD
diff --git a/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher_shard.cpp.in b/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher_shard.cpp.in
--- a/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher_shard.cpp.in
+++ b/csrc/xpu/attn/xe_2/chunk_prefill_dispatcher_shard.cpp.in
@@ -0,0 +1,35 @@
+#include "chunk_prefill.hpp"
+#include "chunk_prefill_dispatcher.hpp"
+#include "chunk_prefill_extern.hpp"
+#include "chunk_prefill_utils.hpp"
+
+using namespace cute;
+
+// clang-format off
+#define IMPL_POLICY_TOKEN ${IMPL_POLICY_TOKEN}
+#define IMPL_POLICY ${IMPL_POLICY}
+// clang-format on
+
+#define CONCAT_INNER(a, b) a##b
+#define CONCAT(a, b) CONCAT_INNER(a, b)
+
+#define SHARD_FUNCTION_NAME \
+  CONCAT(chunk_prefill_dispatch_, IMPL_POLICY_TOKEN)
+
+// One chunk_policy dispatcher shard. The recursive 5-bool peel × 6 dtype
+// trampoline forest (~108 leaves) lives entirely inside this TU. fmha_xe2.cpp
+// performs the head_size + use_b16 routing and calls into the right shard,
+// so the entry TU does not need to include chunk_prefill.hpp (and avoids
+// parsing the CUTLASS / SYCL kernel pipeline templates).
+void SHARD_FUNCTION_NAME(
+    sycl::queue& queue,
+    CutlassQKType& cuQKType,
+    const chunk_prefill_args_t& args,
+    bool is_paged,
+    bool is_causal,
+    bool is_local,
+    bool is_sink,
+    bool is_lse) {
+  policy_dispatch_func<IMPL_POLICY>(
+      queue, cuQKType, args, is_paged, is_causal, is_local, is_sink, is_lse);
+}
