+# Dispatcher shards: split the recursive trampoline forests previously
+# instantiated entirely inside fmha_xe2.cpp / paged_decode_xe2.cpp across
+# generated per-policy / per-(QGroup,PageSize) TUs. The entry TUs no longer
+# include the heavy CUTLASS-bearing headers (chunk_prefill.hpp /
+# paged_decode.hpp), so their peak RSS drops below the kernel_template TU
+# ceiling and the build is safe at -j$(nproc) on a 24-core / 96-GiB box.
+include("chunk_prefill_dispatcher_configure.cmake")
+chunk_prefill_dispatcher_configure(chunk_prefill_dispatcher_shard)
+
+include("paged_decode_dispatcher_configure.cmake")
+paged_decode_dispatcher_configure(paged_decode_dispatcher_shard)
+
 add_xe2_kernel_library(attn_kernels_xe_2 INCLUDE_CMAKE_SOURCE_DIR)
