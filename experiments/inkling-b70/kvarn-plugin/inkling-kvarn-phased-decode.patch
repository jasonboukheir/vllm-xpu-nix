index 0000000..b278f26
--- /dev/null
+++ b/scripts/bench_kvarn_decode.py
@@ -0,0 +1,182 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Time eight-token Inkling target verification with shuffled packed pages."""
+
+import argparse
+import hashlib
+import json
+import random
+import statistics
+import sys
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+from vllm_inkling2_xpu.ops import attention as attn  # noqa: E402
+from vllm_inkling2_xpu.ops import attention_triton  # noqa: E402
+
+
+def power_cap():
+    for path in Path("/sys/class/drm").glob("card*/device/hwmon/hwmon*/power1_cap"):
+        if (path.parent / "name").read_text().strip() == "xe":
+            return int(path.read_text()) / 1e6
+    return None
+
+
+def run(args):
+    if power_cap() != args.watts:
+        raise RuntimeError(f"Expected {args.watts} W, found {power_cap()} W")
+    args.output.parent.mkdir(exist_ok=True, parents=True)
+    torch.manual_seed(31337)
+    local = dict(dtype=torch.bfloat16, device="xpu")
+    h = torch.ones(1, 1)
+    for _ in range(7):
+        h = torch.kron(h, torch.tensor([[1.0, 1.0], [1.0, -1.0]]))
+    h = (h / 128**0.5).to(**local)
+    stage = torch.randn((4, 128, 8, 256), **local)
+    sk, sv = stage.split(128, dim=-1)
+    max_pages = (max(args.lengths) + 127) // 128
+    packed = torch.randint(
+        0, 256, (1 + max_pages, 8, 1, 17920), device="xpu", dtype=torch.uint8
+    )
+    # Supply finite fp16 affine parameters in the exact compact record.
+    for offset, value in (
+        (8192, 0.12),
+        (8448, -0.95),
+        (8704, 1.1),
+        (17152, 0.95),
+        (17408, 0.15),
+        (17664, -1.1),
+    ):
+        packed[..., offset : offset + 256].view(torch.float16).fill_(value)
+    offsets = (torch.randperm(max_pages, dtype=torch.int32) + 1).to("xpu")[None, :]
+    q = torch.randn((8, 24, 128), **local)
+    gate = torch.randn((8, 24 * 128), **local)
+    sinks = torch.randn((8, 24), **local)
+    rel = torch.randn((8 + 128, 24, 1280), **local)
+    result = torch.empty_like(gate)
+    cuq = torch.tensor([0, 8], dtype=torch.int32, device="xpu")
+    slot = torch.tensor([0], dtype=torch.int32, device="xpu")
+    splits = attn.plan_decode_attention(False, 1, 8, 24, 8, 1024)
+    device = torch.xpu.get_device_name()
+    print(
+        f"{device}, {args.watts} W, stock splits {splits}, graph={args.graph}",
+        flush=True,
+    )
+    index = {
+        "device": device,
+        "watts": args.watts,
+        "stock_splits": splits,
+        "graph": args.graph,
+        "cases": {},
+        "torch": torch.__version__,
+        "kernel_sha256": hashlib.sha256(
+            Path(attention_triton.__file__).read_bytes()
+        ).hexdigest(),
+    }
+    for length in args.lengths:
+        seq = torch.tensor([length], device="xpu", dtype=torch.int32)
+
+        def launch():
+            attn.rel_decode_attention(
+                q,
+                sk,
+                sv,
+                rel,
+                gate,
+                sinks,
+                result,
+                block_table=offsets,
+                cache_seqlens=seq,
+                cu_seqlens_q=cuq,
+                max_query_len=8,
+                num_actual_tokens=8,
+                softmax_scale=128**-0.5,
+                is_local=False,
+                num_splits=splits,
+                packed_cache=packed,
+                hadamard=h,
+                req_slots=slot,
+                ring_pages=4,
+            )
+
+        variants = ["control", *args.variants]
+        samples = {v: [] for v in variants}
+        errors = {}
+        graphs = {}
+
+        def select(v):
+            attn._PHASED_DECODE = v != "control"
+            if v != "control":
+                attn._PHASED_BLOCK_N, attn._PHASED_WARPS, attn._PHASED_SPLITS = map(
+                    int, v.split("/")
+                )
+
+        ref = None
+        for v in variants:
+            select(v)
+            launch()
+            torch.xpu.synchronize()
+            got = result.cpu().float()
+            if ref is None:
+                ref = got.clone()
+            err = got - ref
+            errors[v] = {
+                "max_abs": err.abs().max().item(),
+                "relative_l2": (err.norm() / ref.norm()).item(),
+            }
+            torch.testing.assert_close(got, ref, rtol=0.04, atol=0.006)
+            if args.graph:
+                g = torch.xpu.XPUGraph()
+                with torch.xpu.graph(g):
+                    launch()
+                graphs[v] = g
+                g.replay()
+            else:
+                launch()
+            torch.xpu.synchronize()
+        order_rng = random.Random(7)
+        for _ in range(args.repeats):
+            ordering = variants.copy()
+            order_rng.shuffle(ordering)
+            for v in ordering:
+                select(v)
+                callback = graphs[v].replay if args.graph else launch
+                start = torch.xpu.Event(enable_timing=True)
+                end = torch.xpu.Event(enable_timing=True)
+                start.record()
+                for _ in range(args.inner):
+                    callback()
+                end.record()
+                end.synchronize()
+                samples[v].append(start.elapsed_time(end) / args.inner)
+        med = {v: statistics.median(s) for v, s in samples.items()}
+        index["cases"][str(length)] = {
+            "median_ms": med,
+            "samples_ms": samples,
+            "errors": errors,
+        }
+        args.output.write_text(json.dumps(index, indent=2) + "\n")
+        print(length, {v: round(t, 3) for v, t in med.items()}, flush=True)
+        del graphs
+    assert power_cap() == args.watts
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("output", type=Path)
+    ap.add_argument(
+        "--lengths", type=int, nargs="+", default=[4096, 32768, 131072, 245760]
+    )
+    ap.add_argument(
+        "--variants",
+        nargs="+",
+        default=["32/4/0", "32/8/0", "64/4/0", "128/4/0", "64/8/0", "128/8/0"],
+    )
+    ap.add_argument("--repeats", type=int, default=7)
+    ap.add_argument("--inner", type=int, default=3)
+    ap.add_argument("--watts", type=int, default=230)
+    ap.add_argument("--graph", action="store_true")
+    with torch.inference_mode():
+        run(ap.parse_args())
