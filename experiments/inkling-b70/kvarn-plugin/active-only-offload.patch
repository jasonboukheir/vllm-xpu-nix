+    def bind_gpu_block_pool(self, gpu_block_pool: BlockPool) -> None:
+        extra = self._kv_transfer_config.kv_connector_extra_config
+        if extra.get("gpu_cache_policy") == "active_only":
+            if extra.get("spec_name", "CPUOffloadingSpec") != "CPUOffloadingSpec":
+                raise ValueError("gpu_cache_policy=active_only requires CPUOffloadingSpec")
