+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from tests.utils import create_new_process_for_each_test
+from vllm.utils.extensible_tensor import ExtensibleTensor, granule_size
+from vllm.utils.vmm_driver import (
+    MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR,
+    vmm_unavailable_reason,
+)
+
+
+@pytest.mark.skipif(not torch.xpu.is_available(), reason="requires XPU")
+@create_new_process_for_each_test("spawn")
+def test_xpu_reservation_survives_growth_and_remapping() -> None:
+    reason = vmm_unavailable_reason()
+    if reason and "does not support SYCL virtual memory" in reason:
+        pytest.skip(reason)
+    assert reason is None, reason
+    assert "does not export IPC handles" in (
+        vmm_unavailable_reason(MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR) or ""
+    )
+    g = granule_size(torch.xpu.current_device())
+    reservation = ExtensibleTensor(4 * g, device="xpu", num_segments=2)
+    try:
+        # The model runner creates its tensor views before committing pages.
+        full = reservation.full_view()
+        base = full.data_ptr()
+        assert full.device == reservation.device
+        assert reservation.physical_bytes == 0
+        reservation.resize_segments_([g, 64])
+        full[:g].fill_(37)
+        full[2 * g : 2 * g + 64].fill_(71)
+
+        reservation.resize_segments_([g + 64, 64], zero_new=True)
+        assert reservation.physical_bytes == 3 * g
+        assert full[g - 1].item() == 37
+        assert full[g].item() == 0
+        assert reservation.segment_view(1).data_ptr() == base + 2 * g
+        assert reservation.segment_view(1)[-1].item() == 71
+        full[g : g + 64].fill_(19)
+        assert reservation.segment_view(0)[-1].item() == 19
+
+        reservation.release_physical()
+        assert reservation.physical_bytes == 0
+        reservation.resize_segments_([64, 64], zero_new=True)
+        assert reservation.full_view().data_ptr() == base
+        assert full[0].item() == 0
+        assert full[2 * g].item() == 0
+    finally:
+        reservation.free()
