+// =============================================================================
+// Q/KV dtype combinations
+// =============================================================================
+// Six valid (Q, KV) dtype pairs. Q dictates the output dtype (O == Q); KV
+// dictates both K and V. Keep this list in sync with chunk_prefill_configure
+// .cmake and with the runtime dispatcher in chunk_prefill_utils.hpp.
+#define CHUNK_DTYPE_COMBINATIONS(X, ...)            \
+  X(__VA_ARGS__, half_t, half_t)                    \
+  X(__VA_ARGS__, half_t, float_e4m3_t)              \
+  X(__VA_ARGS__, half_t, float_e5m2_t)              \
+  X(__VA_ARGS__, bfloat16_t, bfloat16_t)            \
+  X(__VA_ARGS__, bfloat16_t, float_e4m3_t)          \
+  X(__VA_ARGS__, bfloat16_t, float_e5m2_t)
+
