+@triton.jit
+def _kvarn_key(record, token, d):
+    # K rows are channels and pairs of token nibbles are adjacent.
+    b = tl.load(record + d[:, None] * 64 + token[None, :] // 2)
+    q = ((b >> ((token[None, :] & 1) * 4)) & 15).to(tl.float32)
+    scales = record.to(tl.pointer_type(tl.float16))
+    s_col = tl.load(scales + 8192 // 2 + d).to(tl.float32)
+    zero = tl.load(scales + 8448 // 2 + d).to(tl.float32)
+    s_row = tl.load(scales + 8704 // 2 + token).to(tl.float32)
+    return (q * s_col[:, None] + zero[:, None]) * s_row[None, :]
+
+
+@triton.jit
+def _kvarn_value(record, token, d):
+    # V rows are tokens and pairs of channel nibbles are adjacent.
+    b = tl.load(record + 8960 + token[:, None] * 64 + d[None, :] // 2)
+    q = ((b >> ((d[None, :] & 1) * 4)) & 15).to(tl.float32)
+    scales = record.to(tl.pointer_type(tl.float16))
+    s_col = tl.load(scales + 17152 // 2 + d).to(tl.float32)
+    s_row = tl.load(scales + 17408 // 2 + token).to(tl.float32)
+    zero = tl.load(scales + 17664 // 2 + token).to(tl.float32)
+    return (q * s_row[:, None] + zero[:, None]) * s_col[None, :]
+
