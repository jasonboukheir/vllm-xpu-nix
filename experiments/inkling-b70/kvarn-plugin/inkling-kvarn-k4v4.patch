+class Inkling2KVarNAttentionBackend(Inkling2AttentionBackend):
+    @staticmethod
+    def get_name() -> str:
+        return "INKLING2_KVARN_K4V4"
+
+    @classmethod
+    def get_supported_kernel_block_sizes(cls, kv_cache_spec=None):
+        return [128]
+
+    @staticmethod
+    def get_builder_cls():
+        return Inkling2KVarNMetadataBuilder
+
+
+class Inkling2KVarNMetadataBuilder(Inkling2AttentionMetadataBuilder):
+    def __init__(self, kv_cache_spec, layer_names, vllm_config, device):
+        super().__init__(kv_cache_spec, layer_names, vllm_config, device)
+        if kv_cache_spec.page_size_bytes >= kv_cache_spec.block_size * 8 * 256:
+            raise ValueError(
+                "Cache layout padding eliminates the KVarN saving. "
+                "Select VLLM_KV_CACHE_LAYOUT=BLNHC for the packed target pages."
+            )
+        self.req_slots = torch.empty(
+            vllm_config.scheduler_config.max_num_seqs, dtype=torch.int32, device=device
+        )
+        self.req_cookies = torch.empty_like(self.req_slots, dtype=torch.int64)
+        self.is_prefilling = torch.empty_like(self.req_slots, dtype=torch.bool)
+
+    def build(self, common_prefix_len, common_attn_metadata, fast_build=False):
+        md = super().build(common_prefix_len, common_attn_metadata, fast_build)
+        rows = md.seq_lens.shape[0]
+        indices = common_attn_metadata.req_idx
+        if not hasattr(common_attn_metadata, "req_generation"):
+            raise RuntimeError(
+                "KVarN needs Model Runner V2 request-generation metadata"
+            )
+        epochs = common_attn_metadata.req_generation
+        n = (
+            min(rows, len(indices), len(epochs))
+            if indices is not None and epochs is not None
+            else 0
+        )
+        slots = self.req_slots[:rows]
+        if n:
+            generation = torch.as_tensor(epochs[:n], dtype=torch.int64)
+            owners = torch.as_tensor(indices[:n], dtype=torch.int32).masked_fill(
+                generation == 0, -1
+            )
+            slots[:n].copy_(owners, non_blocking=True)
+            self.req_cookies[:n].copy_(generation, non_blocking=True)
+        slots[n:].fill_(-1)
+        self.req_cookies[n:rows].zero_()
+        prefill = common_attn_metadata.is_prefilling
+        self.is_prefilling[:rows].zero_()
+        if prefill is not None and n:
+            self.is_prefilling[:n].copy_(prefill[:n], non_blocking=True)
+        md.kvarn_req_slots = slots
+        md.kvarn_req_cookies = self.req_cookies[:rows]
+        md.kvarn_is_prefilling = self.is_prefilling[:rows]
+        return md
+
